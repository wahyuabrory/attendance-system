ATTENDANCE_ENVIRONMENT=development
POSTGRES_PASSWORD=attendance-local-only
ATTENDANCE_DATABASE_URL=postgresql+asyncpg://attendance:attendance-local-only@127.0.0.1:5432/attendance
ATTENDANCE_ADMIN_API_KEY=replace-with-a-random-administrator-key
ATTENDANCE_TERMINAL_API_KEY=replace-with-a-random-terminal-key
ATTENDANCE_TOKEN_SIGNING_KEY=replace-with-a-random-signing-key
ATTENDANCE_MODEL_DIR=models
